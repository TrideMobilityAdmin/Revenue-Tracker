# --- Server ---
PORT=5000
NODE_ENV=Revenue_tracker

# --- Database ---
# Local dev (docker-compose):        mongodb://mongo:27017/tride_revenue
# MongoDB Atlas (recommended on AWS): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/tride_revenue
MONGO_URI=mongodb://admin:Tride123@35.154.117.132:27017/
MONGO_DB=Revenue_tracker

# --- Auth ---
# Shared "standard password" gate for the whole tool, per requirement.
# Format kept exactly as given: DD/MM/YYYY
AUTH_PASSWORD=13/08/2020

# Secret used to sign JWTs - CHANGE THIS before deploying to AWS.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://revenue-tracker.tride.live,http://localhost:5173,http://127.0.0.1:5173
